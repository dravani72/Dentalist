# Local development only. Never point these at a database holding real patient data.
DATABASE_URL=postgres://teeth_app:teeth_app_dev@localhost:5432/teeth
DATABASE_OWNER_URL=postgres://teeth_owner:teeth_owner_dev@localhost:5432/teeth
PORT=3000
# Dev-only helpers (TOTP code hint on the login screen). Must be unset in staging/production.
DEV_TOOLS=1
# Local stand-ins for AWS KMS / S3. Production uses the KMS and S3 adapters.
LOCAL_KEY_DIR=./var/keys
LOCAL_MEDIA_DIR=./var/media
# Shared secret the eRx partner uses to sign webhooks (HMAC-SHA256).
ERX_WEBHOOK_SECRET=dev-webhook-secret
RTC_WEBHOOK_SECRET=dev-rtc-webhook-secret
